// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id          String      @id @default(uuid())
  name        String
  description String?
  // Existing roles created before this column was added carry the migration
  // timestamp (2026-08-08) as createdAt; no earlier creation-time source exists.
  createdAt   DateTime    @default(now())
  deletedAt   DateTime?
  users       User[]
  claims      RoleClaim[]
  documents   DocumentRole[]

  // Active-name uniqueness is enforced by a partial unique index
  // (`Role_name_active_key`, WHERE deletedAt IS NULL) created in migration
  // 20260813004832_add_soft_delete; Prisma cannot express partial indexes.
}

model RoleClaim {
  id     String @id @default(uuid())
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  claim  String

  @@unique([roleId, claim])
  @@index([claim])
}

model Category {
  id          String      @id @default(uuid())
  name        String
  description String?
  documents   Document[]
  createdAt   DateTime    @default(now())
  deletedAt   DateTime?

  // Active-name uniqueness enforced via partial unique index in
  // migration 20260813004832_add_soft_delete (`Category_name_active_key`).
}

model Document {
  id              String          @id @default(uuid())
  displayName     String
  fileName        String
  storedName      String          @unique
  mimeType        String
  sizeBytes       Int
  categoryId      String
  category        Category        @relation(fields: [categoryId], references: [id])
  uploadedById    String
  uploadedBy      User            @relation(fields: [uploadedById], references: [id])
  roles           DocumentRole[]
  assignAllRoles  Boolean         @default(false)
  deletedAt       DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([categoryId])
  @@index([deletedAt])
}

model DocumentRole {
  id         String   @id @default(uuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  roleId     String
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([documentId, roleId])
}

model User {
  id            String         @id @default(uuid())
  email         String
  fullName      String
  passwordHash  String
  roleId        String
  role          Role           @relation(fields: [roleId], references: [id])
  refreshTokens RefreshToken[]
  documents     Document[]
  createdAt     DateTime       @default(now())
  deletedAt     DateTime?

  // Active-email uniqueness enforced via partial unique index in
  // migration 20260813004832_add_soft_delete (`User_email_active_key`).
}

model RefreshToken {
  id                String        @id @default(uuid())
  tokenHash         String        @unique
  userId            String
  user              User          @relation(fields: [userId], references: [id])
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?
  replacedByToken   RefreshToken? @relation("RefreshTokenRotation", fields: [replacedByTokenId], references: [id])
  rotatedTokens     RefreshToken[] @relation("RefreshTokenRotation")
  createdAt         DateTime      @default(now())

  @@index([userId])
}
